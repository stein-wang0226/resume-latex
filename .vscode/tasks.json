{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译我的简历",
      "type": "shell",
      "command": "${workspaceFolder}/build.sh",
      "args": ["resume"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "编译空白模板",
      "type": "shell",
      "command": "${workspaceFolder}/build.sh",
      "args": ["template"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
